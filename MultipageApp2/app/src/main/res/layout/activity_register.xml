<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/txtRegTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MangaShelf"
        android:textColor="#e94560"
        android:textSize="36sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtRegSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.25" />

    <TextView
        android:id="@+id/txtRegSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create an account"
        android:textColor="#aaaaaa"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtRegTitle"
        app:layout_constraintBottom_toTopOf="@id/txtLabelRegUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtLabelRegUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="USERNAME"
        android:textColor="#aaaaaa"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtRegSub"
        app:layout_constraintBottom_toTopOf="@id/etRegUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etRegUsername"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_background"
        android:paddingHorizontal="16dp"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:hint="Choose a username"
        android:inputType="text"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtLabelRegUsername"
        app:layout_constraintBottom_toTopOf="@id/txtLabelRegPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtLabelRegPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PASSWORD"
        android:textColor="#aaaaaa"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/etRegUsername"
        app:layout_constraintBottom_toTopOf="@id/etRegPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etRegPassword"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_background"
        android:paddingHorizontal="16dp"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:hint="Choose a password"
        android:inputType="textPassword"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtLabelRegPassword"
        app:layout_constraintBottom_toTopOf="@id/txtLabelRegConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtLabelRegConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CONFIRM PASSWORD"
        android:textColor="#aaaaaa"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/etRegPassword"
        app:layout_constraintBottom_toTopOf="@id/etRegConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etRegConfirm"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_background"
        android:paddingHorizontal="16dp"
        android:textColor="#ffffff"
        android:textColorHint="#666666"
        android:hint="Confirm your password"
        android:inputType="textPassword"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtLabelRegConfirm"
        app:layout_constraintBottom_toTopOf="@id/btnRegister"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Create Account"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:backgroundTint="#e94560"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/etRegConfirm"
        app:layout_constraintBottom_toTopOf="@id/txtBackToLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Already have an account? Log in"
        android:textColor="#aaaaaa"
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnRegister"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>