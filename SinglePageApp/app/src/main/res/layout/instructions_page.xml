<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9191E9">

    <LinearLayout
        android:layout_width="415dp"
        android:layout_height="312dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.383"
        tools:layout_editor_absoluteX="0dp">

        <TextView
            android:layout_width="340dp"
            android:layout_height="42dp"
            android:fontFamily="@font/abril_fatface"
            android:text="Instructions"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="309dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abril_fatface"
            android:paddingTop="10dp"
            android:text="Want to find out which flower suits you? We are here to help you with these simple steps"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <TextView
            android:layout_width="232dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/abril_fatface"
            android:paddingTop="10dp"
            android:text="• Pick a colour\n• Choose a season\n• Enjoy!"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <Button
            android:id="@+id/closeBtn"
            android:layout_width="wrap_content"
            android:layout_height="59dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#C2AFF0"
            android:fontFamily="@font/abril_fatface"
            android:text="Close"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>